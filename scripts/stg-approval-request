#!/bin/bash
# 스테이징 DB 마이그레이션을 확인한 뒤 stg 승인 페이지를 연다.
set -u
key=$(printf '%s' "${1:-}" | tr '[:lower:]' '[:upper:]')
[[ "$key" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]] || { echo "usage: stg-approval-request <KEY>" >&2; exit 3; }
here=$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().parent)' "$0")
python3 "$here/check_migrations.py" --key "$key"
code=$?
if [ "$code" -ne 0 ]; then
  echo "stg-approval-request: waiting=human-risk (migration check exit=$code); approval page blocked" >&2
  exit "$code"
fi
exec /bin/bash "$here/decision-request" stg-approval "$key"
