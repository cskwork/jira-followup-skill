#!/bin/bash
# Jira follow-up 라인의 tick 진입점 (스케줄러의 싼 깨우기 모델이 이 명령 하나만 실행한다).
# - 판단은 하지 않는다. jira-daily-guard가 중복·잠금·idle을 정하고, 일이 있을 때만
#   오케스트레이터(ORCHESTRATOR.md, 기본 claude-opus-5-5 high)를 분리 실행한다. 고가 모델은 idle tick에 뜨지 않는다.
# - 잠금($JIRA_FOLLOWUP_HOME/running)은 가드가 잡고 오케스트레이터가 끝에서 푼다.
#   오케스트레이터를 띄우지 못하면 여기서 바로 푼다.
# - JIRA_WAKE_DRY_RUN=1: 띄울 명령만 출력하고 잠금을 푼다(시험용).
set -u
# 설정: $JIRA_FOLLOWUP_HOME/config.env(기본 ~/.jira-followup, git 밖). 이미 설정된 환경변수가 우선한다.
: "${JIRA_FOLLOWUP_HOME:=$HOME/.jira-followup}"
if [ -f "${JIRA_FOLLOWUP_CONFIG:-$JIRA_FOLLOWUP_HOME/config.env}" ]; then
  eval "$(python3 -c 'import os, shlex, sys
for line in open(sys.argv[1], encoding="utf-8"):
    line = line.strip()
    if line and not line.startswith("#") and "=" in line:
        k, v = line.split("=", 1); k = k.strip(); v = v.strip().strip(chr(34)).strip(chr(39))
        if v and k.isidentifier() and k not in os.environ:
            print("export %s=%s" % (k, shlex.quote(os.path.expanduser(v))))' "${JIRA_FOLLOWUP_CONFIG:-$JIRA_FOLLOWUP_HOME/config.env}")"
fi
here=$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve().parent)' "$0")
skill=$(dirname "$here")
guard="${JIRA_WAKE_GUARD:-$HOME/.local/bin/jira-daily-guard}"
workspace="${JIRA_WAKE_CWD:-${JIRA_FOLLOWUP_WORKSPACE:-$PWD}}"

# Manual run: jira-daily-wake --now [--key PROJ-NNN] (사용자 요청, tick 시간과 무관).
guard_args=() focus="" trigger=tick
while [ $# -gt 0 ]; do
  case "$1" in
    --now) guard_args+=(--manual); trigger=manual ;;
    --dir) shift; [ -n "${1:-}" ] || { echo "jira-daily-wake: --dir needs a path" >&2; exit 2; }
           export JIRA_WAKE_DIR="$1" ;;
    --key) shift; focus=${1:-}
           [[ "$focus" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]] || { echo "jira-daily-wake: --key needs PROJ-NNN" >&2; exit 2; } ;;
    *) echo "usage: jira-daily-wake [--now] [--key PROJ-NNN] [--dir PATH]" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$focus" ] && [ "$trigger" = tick ] && { echo "jira-daily-wake: --key requires --now" >&2; exit 2; }
state_dir="${JIRA_WAKE_DIR:-$JIRA_FOLLOWUP_HOME}"
state_args=()
[ -n "${JIRA_WAKE_DIR:-}" ] && state_args=(--dir "$state_dir")
guard_args+=(${state_args[@]+"${state_args[@]}"})

# The supervisor owns tick evidence and lives outside the scheduler's session.
# Manual runs keep the original synchronous path; FOREGROUND is for offline tests.
if [ "$trigger" = tick ] && [ "${JIRA_WAKE_CHILD:-}" != 1 ]; then
  [ "${JIRA_WAKE_FOREGROUND:-}" = 1 ] && exec python3 "$here/wake_supervisor.py" run "$0"
  exec python3 "$here/wake_supervisor.py" detach "$0"
fi

out=$(/bin/bash "$guard" ${guard_args[@]+"${guard_args[@]}"}) || exit $?
printf '%s\n' "$out"
case "$out" in *"skipping duplicate"*)
  # 잠금 때문에 미룬 수동 요청은 다음 가드가 반드시 다시 깨운다.
  if [ -n "$focus" ] && [[ "$out" == *"(running)"* ]]; then
    python3 "$here/state_update.py" --dir "$state_dir" append-pending --json "{\"key\":\"$focus\",\"trigger\":\"$trigger\",\"at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" || exit $?
  fi
  exit 0 ;;
esac

token=$(python3 "$here/run_lock.py" token --dir "$state_dir") || exit $?

mode=$(printf '%s\n' "$out" | sed -n 's/^mode=//p' | tail -1)
if [ "$mode" != "morning" ] && [ "$mode" != "tick" ]; then
  /bin/bash "$guard" --release --token "$token" ${state_args[@]+"${state_args[@]}"} >/dev/null
  echo "jira-daily-wake: guard gave no mode line; released"
  exit 1
fi

guard_reasons=$(python3 - "$state_dir/guard-last.json" <<'PY'
import json
from pathlib import Path
import sys
try:
    reasons = json.loads(Path(sys.argv[1]).read_text()).get("reasons", [])
    print(",".join(reason for reason in reasons if isinstance(reason, str)))
except (OSError, ValueError, AttributeError, TypeError):
    print("")
PY
)
state_json=$(python3 -c 'import json, sys; from pathlib import Path; print(json.dumps(str(Path(sys.argv[1]).resolve())))' "$state_dir")
prompt="You are the Jira follow-up factory orchestrator. mode=$mode run_token=$token trigger=$trigger${focus:+ focus=$focus} guard_reasons=$guard_reasons state_dir=$state_json. Read $skill/ORCHESTRATOR.md and follow it exactly. Use state_dir for state, worker briefs, logs, and guard --dir and --token when releasing the lock. Pass --dir $state_json --token $token to every jira-worker call. Your own role is minimal: decide, delegate with jira-worker, check the verifier results, report the whole picture, then release the lock."
# PASEO_AGENT_ID·PASEO_WORKSPACE_ID를 빼야 스케줄 실행 에이전트의 자식이 되지 않는다.
# 자식이면 스케줄이 끝나 실행 에이전트를 보관할 때 오케스트레이터도 함께 보관된다(실측: 매번 3~5초 만에 종료).
cmd=(env -u PASEO_AGENT_ID -u PASEO_WORKSPACE_ID
     "${PASEO_BIN:-paseo}" run --no-wait --provider "${ORCHESTRATOR_PROVIDER:-claude}" --model "${ORCHESTRATOR_MODEL:-claude-opus-5-5}"
     --thinking "${ORCHESTRATOR_THINKING:-high}"
     --mode "${ORCHESTRATOR_MODE:-bypassPermissions}" --cwd "$workspace" --title "Jira orchestrator $mode $(date +%H:%M)"
     --label factory=jira-followup --label role=orchestrator --label run="$token" -q "$prompt")

if [ "${JIRA_WAKE_DRY_RUN:-}" = "1" ]; then
  printf 'dry-run:'; printf ' %q' "${cmd[@]}"; printf '\n'
  /bin/bash "$guard" --release --token "$token" ${state_args[@]+"${state_args[@]}"} >/dev/null
  exit 0
fi

# 자기 상태 폴더에서 ended가 확인된 토큰만 보관한다.
python3 "$here/run_lock.py" archive --dir "$state_dir"

if ! id=$("${cmd[@]}" 2>/dev/null) || [ -z "$id" ]; then
  /bin/bash "$guard" --release --token "$token" ${state_args[@]+"${state_args[@]}"} >/dev/null
  echo "jira-daily-wake: orchestrator launch failed; released"
  exit 1
fi
if [ -n "$token" ]; then
  python3 "$here/run_lock.py" attach --dir "$state_dir" --token "$token" --id "$id" || exit $?
fi
echo "orchestrator=$id mode=$mode"
