# jira-followup settings. Copy to $JIRA_FOLLOWUP_HOME/config.env (default ~/.jira-followup/config.env):
#   mkdir -p ~/.jira-followup && cp config.example.env ~/.jira-followup/config.env
# The real config.env lives outside the repo and is git-ignored. Never put a token value here;
# point to a file (JIRA_TOKEN_FILE) or export JIRA_API_TOKEN in your shell instead.
# Format: KEY=VALUE per line. Environment variables that are already set win.

# --- Jira ---------------------------------------------------------------
JIRA_SITE=your-site.example.com
JIRA_PROJECT=PROJ
# Your own Jira accountId (Profile URL or `acli jira workitem view <KEY> --json` -> assignee.accountId)
JIRA_ACCOUNT_ID=000000:00000000-0000-0000-0000-000000000000
JIRA_EMAIL=you@example.com
JIRA_TOKEN_FILE=~/.config/jira/token
# Optional: command that re-authenticates acli once after "unauthorized"; hint shown to the human
JIRA_REAUTH_CMD=
JIRA_REAUTH_HINT=acli jira auth login
JIRA_FOLLOWUP_TZ=Asia/Seoul

# Workflow statuses (Jira display names), promotion order. Edit to match your workflow.
STATUS_ORDER=진행 중,개발 QA 요청,개발 검수 완료,스테이징 QA 요청,스테이징 검수 완료,릴리즈 대기,운영계 배포 완료
# Status a ticket should reach when all its commits are on the dev / stg / main branch
STATUS_ON_DEV=개발 QA 요청
STATUS_ON_STG=스테이징 QA 요청
STATUS_ON_PROD=운영계 배포 완료
# Resolved-but-not-released statuses still watched for mentions (30 days)
STATUS_DONE_NOT_RELEASED=개발 검수 완료,스테이징 QA 요청,스테이징 검수 완료,릴리즈 대기
# Released statuses: new issues reported there become linked follow-up tickets (spinoff_ticket.py)
STATUS_POST_RELEASE=운영계 배포 완료,운영 검수 완료
STATUS_TODO=할 일
SPINOFF_ISSUE_TYPE=버그
# Summaries of release-tracker tickets that must not count as related follow-ups (regex)
RELEASE_TRACKER_RE=^\s*(Release_)
# Extra words ignored when matching related tickets (comma-separated)
RELATED_STOP_WORDS=

# --- Workspace and git ----------------------------------------------------
# Directory that contains your service repositories (and .sdlc/ when you use sdlc-kit)
JIRA_FOLLOWUP_WORKSPACE=~/work/my-product
REPO_GLOB=*
BRANCH_DEV=dev
BRANCH_STG=stg
BRANCH_MAIN=main
MIGRATION_GLOB=docs/db/migration/*.sql

# --- Environments (dev and staging only; never production) ----------------
# VPN status CLI printing {"active":[{"profile":"dev|stg","state":"CONNECTED"}]}; `none` = no VPN
VPN_STATUS_CMD=none
# DB query CLI: `<cmd> <config-name> "<sql>"` -> {"rows":[...]}; config names are <db><suffix>
DB_QUERY_CMD=python3 ~/tools/db/query.py
DB_TOOL_DIR=~/tools/db
DB_PRIMARY=app
DB_CONFIG_SUFFIX_DEV=_dev
DB_CONFIG_SUFFIX_STG=_stg
# Repo-name prefix -> DB name for the staging migration gate (empty = DB_PRIMARY for all)
DB_SERVICE_MAP=
# `SELECT @@hostname` prefixes proving which DB the connection really reached
DB_HOST_PREFIX_DEV=dev-db
DB_HOST_PREFIX_STG=stg-db
AI_HEALTH_URL_DEV=https://ai.dev.example.com/docs
AI_HEALTH_URL_STG=https://ai.stg.example.com/docs
WEB_HEALTH_URL_DEV=https://dev.example.com/actuator/health
WEB_HEALTH_URL_STG=https://stg.example.com/actuator/health
JK_CONTEXT_DEV=dev

# --- Agents (Paseo runner) ------------------------------------------------
PASEO_BIN=paseo
# Optional same-slot de-duplication helper; skipped when the file does not exist
PASEO_ONCE_BIN=~/.local/bin/paseo-once
ORCHESTRATOR_PROVIDER=claude
ORCHESTRATOR_MODEL=claude-opus-5-5
ORCHESTRATOR_THINKING=high
ORCHESTRATOR_MODE=bypassPermissions
WORKER_SOL_PROVIDER=codex
WORKER_SOL_MODEL=gpt-6.1-sol
WORKER_SOL_THINKING=high
WORKER_SOL_MODE=full-access
WORKER_OPUS_PROVIDER=claude
WORKER_OPUS_MODEL=claude-opus-5-5
WORKER_OPUS_THINKING=medium
WORKER_OPUS_MODE=bypassPermissions
# Cheap one-comment-at-a-time classifier used by followup_triage.py (codex exec)
TRIAGE_MODEL=gpt-6-luna

# --- Companion skills and optional integrations ---------------------------
# jira-comment-format (https://github.com/cskwork/jira-comment-format-skill) scripts/ directory
COMMENT_FORMAT_DIR=~/.agents/skills/jira-comment-format/scripts
SDLC_KIT=~/.agents/skills/sdlc-kit
# Developer-note board (same contract as jira-comment-format dev_note.py); empty = skip
DEV_NOTE_CLI=
DEV_NOTE_BASE=https://notes.example.com
DEV_NOTE_SPACE=NOTE
DEV_NOTE_WORKSPACE=
# Chat watcher (writes {"status":"ok","events":[...]}) and approved-draft sender; empty = off
FOLLOWUP_IDLE_TEAMS_CMD=
CHAT_SEND_CMD=
# Desktop notification command (receives the message as last argument); empty = macOS osascript
FOLLOWUP_IDLE_NOTIFY_CMD=
BROWSER_OPEN_CMD=open
# Optional wrapper prefixed to morning-check commands
CMD_PREFIX=
LINE_TITLE=Jira follow-up line
